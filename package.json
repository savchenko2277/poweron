{
	"name": "gulp-starter",
	"version": "0.0.2",
	"scripts": {
		"postinstall": "",
		"bem": "bemtree-from-html",
		"dev": "gulp watch --dev --sync",
		"icons": "gulp icons",
		"remote": "gulp watch --remote",
		"build": "gulp build",
		"build-nomin": "gulp build --nomin",
		"deploy-all": "gulp deploy --all",
		"deploy": "gulp deploy"
	},
	"keywords": [
		"bem",
		"html",
		"scss",
		"gulp"
	],
	"author": "Anton Savchenko <jokatikop@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savchenko2277/gulp-starter"
	},
	"license": "ISC",
	"devDependencies": {
		"@babel/core": "^7.21.8",
		"@babel/preset-env": "^7.21.5",
		"babel-loader": "^9.1.2",
		"bemtree-from-html": "^2.0.0",
		"browser-sync": "^2.29.1",
		"del": "^6.0.0",
		"fancy-log": "^2.0.0",
		"gulp": "^4.0.2",
		"gulp-autoprefixer": "^8.0.0",
		"gulp-clean-css": "^4.3.0",
		"gulp-file-include": "^2.3.0",
		"gulp-fonter": "^0.3.0",
		"gulp-glob-sass": "^1.0.3",
		"gulp-group-css-media-queries": "^1.2.2",
		"gulp-if": "^3.0.0",
		"gulp-load-plugins": "^2.0.8",
		"gulp-newer": "^1.4.0",
		"gulp-replace": "^1.1.4",
		"gulp-sass": "^5.1.0",
		"gulp-sourcemaps": "^3.0.0",
		"gulp-svg-sprite": "^2.0.3",
		"gulp-ttf2woff2": "^4.0.1",
		"gulp-typograf": "^4.1.0",
		"gulp-webp": "^4.0.1",
		"include-media": "^2.0.0",
		"sass": "^1.62.1",
		"vinyl-ftp": "^0.6.1",
		"webpack-stream": "^7.0.0"
	},
	"externalJs": {},
	"ftp": {
		"host": "",
		"user": "",
		"password": "",
		"workdir": ""
	},
	"bemtree": {
		"from": "src/**/[^-]*.html",
		"to": "src/blocks",
		"js": "src/js/blocks.js",
		"omit": "@@,js-,active,opened,moved,svg,sprite,icon-box,swiper,mb,button-",
		"prefix": "@use 'lib' as *;",
		"suffix": "$self: &;"
	},
	"dependencies": {
		"@fancyapps/ui": "^6.1.14",
		"swiper": "^12.0.2"
	}
}
